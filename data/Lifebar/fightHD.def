;=======================================================================
;=======================================================================
;=======================================================================
; MUGEN Battle Climax Lifebars
;=======================================================================

; Notes about fonts:
;   - do not index fonts greater than 9 (crash)
;   - fonts indexed here do not refer to the ones in
;     system.def
;
; See the section "How to Customize" at the end of
; this file.

;-----------------------------------------------------------
;Directories are checked in this order:
;1. current directory fight.def is in
;2. data/
;3. your MUGEN directory

[Info]
localcoord = 1280,720
name = "MUGEN Battle CliMAX Standard Portraits"          	;Name of motif
author = "V-Nix/edited by Aʟᴇᴊᴀɴᴅʀᴏ"       			;Motif author name

[Files]
sff 			= Lifebar/fightHD.sff
snd 			= Lifebar/fight.snd
font1 			= Lifebar/VPHD_Power.def
font2 			= Lifebar/VPHD_Combo.def
font3 			= Lifebar/VPHD_Name.def
font4 			= Lifebar/VPHD_Power_Red.def
font5 			= Lifebar/VPHD_Time.def
font6 			= Lifebar/VPHD_Name2.def
fightfx.sff = Lifebar/flashy-fightfx.sff
fightfx.air = Lifebar/flashy-fightfx.air
common.snd		= common.snd

;-----------------------------------------------------------
[FightFx]
scale = 1.5 ; Chnage this to configure size of hitsparks

;====================================================================

[Lifebar]
;Player 1
;----------------------------------
p1.pos    		= 0,0
;-------

p1.bg0.anim		= 170 ; Timer Circle
p1.bg0.offset 		= 640,89
p1.bg0.layerno 		= 0

p1.bg1.spr 		= 11,0

p1.bg2.anim 		= ;180
p1.bg2.offset 		= 640,81

;-------
p1.mid.anim 		= 201
p1.mid.offset 		= 0,0
;-------
p1.front.spr 		= 200,0
p1.front.offset 		= 0,0;22
;-------
p1.range.x  		= 558,128;430

p1.front.palfx.add   = 32,-256,-256
p1.front.palfx.mul   =  256,256,256
p1.front.palfx.sinadd = 256,256,256,20
p1.front66.spr = 200,0
p1.front66.scale   =  1,1
p1.front66.facing   = 1
p1.front66.layerno = 0
;p1.front66.palfx.add   =  256,0,0
p1.front66.palfx.mul   =  256,192,203
p1.front66.palfx.sinadd =  0,0,0
p1.front33.spr = 200,0
p1.front33.scale   =  1,1
p1.front33.facing   = 1
p1.front33.layerno = 0
;p1.front33.palfx.add   =  256,255,0
p1.front33.palfx.mul   =  256,255,0
p1.front33.palfx.sinadd =  128,64,0

;Player 2
;-----------------------------------
p2.pos    		= 0,0
;-------
p2.bg0.anim 		= ;180
p2.bg0.offset 		= 640,78;75
p2.bg0.layerno 		= 0

p2.bg1.spr 		= -1
p2.bg1.layerno 		= 0

p2.bg2.spr 		= 11,2

;-------
p2.mid.anim 		= 211
p2.mid.offset 		= 0,0
;-------
p2.front.spr 		= 201,0
p2.front.offset 		= 0,0;22
;-------
p2.range.x 		= 722,1152;430

p2.front.palfx.add   = 32,-256,-256
p2.front.palfx.mul   =  256,256,256
p2.front.palfx.sinadd = 256,256,256,20
p2.front66.spr = 201,0
p2.front66.scale   =  1,1
p2.front66.facing   = 1
p2.front66.layerno = 0
;p1.front66.palfx.add   =  256,0,0
p2.front66.palfx.mul   =  256,192,203
p2.front66.palfx.sinadd =  0,0,0
p2.front33.spr = 201,0
p2.front33.scale   =  1,1
p2.front33.facing   = 1
p2.front33.layerno = 0
;p1.front33.palfx.add   =  256,255,0
p2.front33.palfx.mul   =  256,255,0
p2.front33.palfx.sinadd =  128,64,0

;-------------------

; Timer 1
[Begin Action 170]
11,1, 0,0, 300,,,1,1
11,1, 0,0, 60,,,1,1
Interpolate Scale
11,1, 0,0, 60, , ,0,1
Interpolate Scale
11,1, 0,0, 300,,,1,1
11,1, 0,0, 60,,,1,1
Interpolate Scale
11,1, 0,0, 60, , ,0,1
Interpolate Scale
11,1, 0,0, 1,,,1,1

; Life P1 Hit
[Begin Action 201]
202,0, 0,0, 5,,,1,1,0
202,0, 0,0, 10, , AS256D0, 1,1,0
Interpolate Blend
202,0, 0,0, 10, , AS128D128, 1,1,0
202,0, 0,0, 10, , AS128D128, 1,1,0
Interpolate Blend
202,0, 0,0, 5, , AS256D0, 1,1,0

; Life P2 Hit
[Begin Action 211]
202,1, 0,0, 5,,,1,1,0
202,1, 0,0, 10, , AS256D0, 1,1,0
Interpolate Blend
202,1, 0,0, 10, , AS128D128, 1,1,0
202,1, 0,0, 10, , AS128D128, 1,1,0
Interpolate Blend
202,1, 0,0, 5, , AS256D0, 1,1,0
;------------------

